# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/proposal_builder"

# NextAuth Configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# SMTP Configuration (Required for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Proposal Builder"

# AWS S3 Configuration (Optional - for file uploads)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="proposal-builder-assets"
# AWS_REGION="us-east-1"
